import sys
src = open('main.c', encoding='utf-8').read()
def rep(old, new):
    global src
    if src.count(old) != 1:
        print("FAIL", src.count(old), repr(old[:150])); sys.exit(1)
    src = src.replace(old, new)
def slice_rep(a, b, new):
    global src
    s = src.find(a); e = src.find(b, s+1)
    if s < 0 or e < 0: print("FAIL slice", repr(a[:80]), repr(b[:80]), s, e); sys.exit(1)
    src = src[:s] + new + src[e:]

