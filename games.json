cover_block = r'''// ------------------------------------------------------------
// ANH BIA GAME
// ------------------------------------------------------------

static SDL_Thread *coverThread = NULL;
static int loadedCovers = 0;
static int coversLoadedThisFrame = 0;

typedef struct {
    FILE *file;
    size_t total;
} CoverWriteContext;

static unsigned int hashString(const char *s)
{
    unsigned int h = 5381;

    while (*s)
        h = (h * 33) ^ (unsigned char)*s++;

    return h;
}

/* Ten file cache co hash cua URL: doi link anh -> tu dong tai lai */
static void coverPathFor(const Game *g, char *out, size_t size)
{
    char name[100];

    makeSafeFolderName(
        g->id[0] ? g->id : g->title,
        name,
        sizeof(name)
    );

    snprintf(
        out, size, "%s/%s-%08x.img",
        COVER_DIR, name, hashString(g->cover)
    );
}

static size_t coverWriteCallback(
    void *data,
    size_t size,
    size_t nmemb,
    void *userp
)
{
    CoverWriteContext *ctx = (CoverWriteContext *)userp;
    size_t bytes = size * nmemb;

    if (ctx->total + bytes > COVER_MAX_BYTES)
        return 0;

    ctx->total += bytes;

    return fwrite(data, size, nmemb, ctx->file);
}

static bool downloadCover(const Game *g, const char *path)
{
    char tmp[MAX_PATH_LEN];

    snprintf(tmp, sizeof(tmp), "%s.tmp", path);

    FILE *f = fopen(tmp, "wb");

    if (!f)
        return false;

    CURL *curl = curl_easy_init();

    if (!curl) {
        fclose(f);
        remove(tmp);
        return false;
    }

    CoverWriteContext ctx = { f, 0 };

    curl_easy_setopt(curl, CURLOPT_URL, g->cover);
    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, coverWriteCallback);
    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &ctx);

    applyCommonCurlOptions(curl);

    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
    curl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);
    curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
    curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, catalogProgress);

    CURLcode result = curl_easy_perform(curl);

    long httpCode = 0;

    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &httpCode);
    curl_easy_cleanup(curl);

    bool ok = (fclose(f) == 0) &&
              result == CURLE_OK &&
              httpCode == 200 &&
              ctx.total > 0;

    if (ok) {
        remove(path);
        ok = (rename(tmp, path) == 0);
    }

    if (!ok)
        remove(tmp);

    return ok;
}

/* Thread tai anh bia lan luot theo thu tu danh sach (anh da co thi bo qua) */
static int coverDownloadThread(void *unused)
{
    (void)unused;

    for (int i = 0; i < gameCount && running; i++) {
        Game *g = &games[i];

        if (!g->cover[0]) {
            g->coverFetch = -1;
            continue;
        }

        char path[MAX_PATH_LEN];

        coverPathFor(g, path, sizeof(path));

        if (fileIsReadable(path)) {
            g->coverFetch = 1;
            continue;
        }

        g->coverFetch = downloadCover(g, path) ? 1 : -1;
    }

    return 0;
}

static void startCoverDownloads(void)
{
    if (coverThread || gameCount <= 0)
        return;

    coverThread = SDL_CreateThreadWithStackSize(
        coverDownloadThread,
        "CoverDownload",
        THREAD_STACK_SIZE,
        NULL
    );
}

static bool evictOldestCover(void)
{
    int oldest = -1;

    for (int i = 0; i < gameCount; i++) {
        if (!games[i].coverTexture)
            continue;

        if (oldest < 0 ||
            games[i].coverUsed < games[oldest].coverUsed)
            oldest = i;
    }

    if (oldest < 0)
        return false;

    SDL_DestroyTexture(games[oldest].coverTexture);

    games[oldest].coverTexture = NULL;
    games[oldest].coverState = 0;

    loadedCovers--;

    return true;
}

static SDL_Texture *loadCoverTexture(
    const char *path,
    int *outW,
    int *outH
)
{
    SDL_Surface *source = IMG_Load(path);

    if (!source)
        return NULL;

    SDL_Surface *use = source;
    SDL_Surface *scaled = NULL;

    int maxDim = source->w > source->h ? source->w : source->h;

    /* Thu nho anh qua lon de tiet kiem bo nho */
    if (maxDim > COVER_MAX_DIM) {
        int nw = source->w * COVER_MAX_DIM / maxDim;
        int nh = source->h * COVER_MAX_DIM / maxDim;

        if (nw < 1) nw = 1;
        if (nh < 1) nh = 1;

        scaled = SDL_CreateRGBSurfaceWithFormat(
            0, nw, nh, 32, SDL_PIXELFORMAT_RGBA32
        );

        if (scaled && SDL_BlitScaled(source, NULL, scaled, NULL) == 0)
            use = scaled;
    }

    SDL_Texture *texture =
        SDL_CreateTextureFromSurface(renderer, use);

    if (texture) {
        *outW = use->w;
        *outH = use->h;
    }

    SDL_FreeSurface(source);

    if (scaled)
        SDL_FreeSurface(scaled);

    return texture;
}

static SDL_Texture *getCoverTexture(Game *g)
{
    if (!g->cover[0])
        return NULL;

    Uint32 now = SDL_GetTicks();

    g->coverUsed = now;

    if (g->coverTexture)
        return g->coverTexture;

    if (g->coverState < 0)
        return NULL;

    /* Moi khung hinh chi nap toi da 1 anh de khong bi giat */
    if (coversLoadedThisFrame >= 1)
        return NULL;

    if (now < g->coverNextCheck)
        return NULL;

    g->coverNextCheck = now + 500;

    char path[MAX_PATH_LEN];

    coverPathFor(g, path, sizeof(path));

    if (!fileIsReadable(path)) {
        if (g->coverFetch != 0)
            g->coverState = -1;

        return NULL;
    }

    while (loadedCovers >= COVER_CACHE_MAX) {
        if (!evictOldestCover())
            break;
    }

    int w = 0;
    int h = 0;

    SDL_Texture *texture = loadCoverTexture(path, &w, &h);

    coversLoadedThisFrame++;

    if (!texture) {
        remove(path);
        g->coverState = -1;
        return NULL;
    }

    g->coverTexture = texture;
    g->coverW = w;
    g->coverH = h;
    g->coverState = 1;

    loadedCovers++;

    return texture;
}

static void drawCover(Game *g, int x, int y, int w, int h)
{
    fillRect(x, y, w, h, (SDL_Color){20, 25, 36, 255});

    SDL_Texture *texture = getCoverTexture(g);

    if (texture && g->coverW > 0 && g->coverH > 0) {
        float sx = (float)w / (float)g->coverW;
        float sy = (float)h / (float)g->coverH;
        float scale = sx < sy ? sx : sy;

        int dw = (int)(g->coverW * scale);
        int dh = (int)(g->coverH * scale);

        SDL_Rect rect = {
            x + (w - dw) / 2,
            y + (h - dh) / 2,
            dw,
            dh
        };

        SDL_RenderCopy(renderer, texture, NULL, &rect);
        return;
    }

    const char *label =
        (!g->cover[0] || g->coverState < 0)
            ? "Khong anh"
            : "Dang tai";

    drawCenteredText(
        label, x + w / 2, y + h / 2 - 9,
        smallFont, grayColor
    );
}

static void drawBackground(void)
{
    coversLoadedThisFrame = 0;

